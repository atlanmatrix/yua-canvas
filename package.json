{
  "name": "yua-canvas",
  "version": "1.0.0",
  "description": "A local-first infinite canvas for ideas, images, and files",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test",
    "check:worker": "tsc -p worker/tsconfig.json",
    "dev:cloud": "wrangler dev --port 8787",
    "db:local": "wrangler d1 migrations apply yua-canvas --local",
    "deploy:cloud": "npm run build && npm run check:worker && wrangler deploy",
    "test:cloud": "node --test tests/cloud-api.mjs",
    "test:pwa": "node --test tests/pwa-production.mjs",
    "icons": "node scripts/render-icons.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atlanmatrix/yua-canvas.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/atlanmatrix/yua-canvas/issues"
  },
  "homepage": "https://github.com/atlanmatrix/yua-canvas#readme",
  "private": true,
  "dependencies": {
    "dompurify": "^3.4.17",
    "fflate": "^0.8.3",
    "flowchart.js": "^1.18.1",
    "lucide-react": "^1.61.0",
    "mermaid": "^12.2.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261027.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.153.0"
  }
}
